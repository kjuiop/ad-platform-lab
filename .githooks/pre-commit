#!/usr/bin/env bash
set -euo pipefail

# 스테이징된 java 파일 목록 캡처
staged_java_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.java$' || true)
if [ -z "$staged_java_files" ]; then
  echo "[pre-commit] No staged .java files. Skipping."
  exit 0
fi

# Spotless 플러그인이 선언되어 있지 않으면 스킵
if ! grep -q 'spotless' build.gradle.kts 2>/dev/null; then
  echo "[pre-commit] Spotless plugin not configured. Skipping format check."
  echo "[pre-commit] To enable: add 'com.diffplug.spotless' plugin to build.gradle.kts"
  exit 0
fi

echo "[pre-commit] Running Spotless (auto-fix)..."

./gradlew -q spotlessApply

echo "$staged_java_files" | while IFS= read -r f; do git add "$f"; done

if ! git diff --cached --quiet; then
  echo "[pre-commit] Spotless applied. Staged diff summary:"
  git diff --cached --stat
fi

echo "[pre-commit] Done."
